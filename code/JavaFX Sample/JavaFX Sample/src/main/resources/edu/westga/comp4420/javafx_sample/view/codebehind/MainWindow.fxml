<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane fx:id="guiPane" minHeight="99.0" minWidth="160.0" prefHeight="472.0" prefWidth="627.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.javafx_sample.view.codebehind.MainWindow">
   <children>
      <ListView fx:id="patternListView" layoutX="71.0" layoutY="43.0" prefHeight="278.0" prefWidth="414.0" />
      <Button layoutX="153.0" layoutY="344.0" mnemonicParsing="false" onAction="#newPatternBTN" prefHeight="51.0" prefWidth="150.0" text="New Pattern">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="153.0" layoutY="407.0" mnemonicParsing="false" onAction="#deletePatternBTN" prefHeight="51.0" prefWidth="150.0" text="Delete Pattern">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="323.0" layoutY="344.0" mnemonicParsing="false" onAction="#updatePatternBTN" prefHeight="51.0" prefWidth="150.0" text="Update Pattern">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="323.0" layoutY="407.0" mnemonicParsing="false" onAction="#showPatternInfoBTN" prefHeight="51.0" prefWidth="150.0" text="Pattern Information">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <MenuBar layoutY="2.0" prefHeight="25.0" prefWidth="627.0">
					<menus>
						<Menu text="Craft Filter">
							<items>
								<MenuItem fx:id="filterCrochetMenuItem"
									onAction="#handleFilterCrochet" text="Crochet">
								</MenuItem>
								<MenuItem fx:id="filterKnitMenuItem"
									onAction="#handleFilterKnit" text="Knit">
								</MenuItem>
							</items>
						</Menu>
						<Menu text="Yarn Weight Filter">
							<items>
								<MenuItem fx:id="filterWeightOneMenuItem"
									onAction="#handleFilterWeightOne" text="Weight 1">
								</MenuItem>
								<MenuItem fx:id="filterWeightTwoMenuItem"
									onAction="#handleFilterWeightTwo" text="Weight 2">
								</MenuItem>
                        <MenuItem fx:id="filterWeightThreeMenuItem"
									onAction="#handleFilterWeightThree" text="Weight 3">
								</MenuItem>
                        <MenuItem fx:id="filterWeightFourMenuItem"
									onAction="#handleFilterWeightFour" text="Weight 4">
								</MenuItem>
                        <MenuItem fx:id="filterWeightFiveMenuItem"
									onAction="#handleFilterWeightFive" text="Weight 5">
								</MenuItem>
                        <MenuItem fx:id="filterWeightSixMenuItem"
									onAction="#handleFilterWeightSix" text="Weight 6">
								</MenuItem>
							</items>
						</Menu>
					</menus>
				</MenuBar>
   </children>
</AnchorPane>
